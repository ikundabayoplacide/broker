{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "lib": ["ES2020"],
    "noEmit": true
  },
  "include": ["scripts/**/*.ts", "scripts/**/*.js"],
  "exclude": ["node_modules", "src", ".next", "**/*.tsx"]
}
